#!/bin/sh
# Block the commit unless the whole test suite passes (failures AND collection errors).
# Install once:  git config core.hooksPath scripts/git-hooks
# Skip only in an emergency: git commit --no-verify  (CLAUDE.md: don't)
ROOT="$(git rev-parse --show-toplevel)"
if [ -x "$ROOT/.venv/Scripts/python.exe" ] || [ -x "$ROOT/.venv/Scripts/python" ]; then
    PY="$ROOT/.venv/Scripts/python"
elif [ -x "$ROOT/.venv/bin/python" ]; then
    PY="$ROOT/.venv/bin/python"
else
    echo "pre-commit: no .venv found; create it first (see README)" >&2
    exit 1
fi
echo "pre-commit: running pytest ..."
cd "$ROOT" && "$PY" -m pytest -q -p no:cacheprovider
status=$?
if [ $status -ne 0 ]; then
    echo "pre-commit: pytest exited with $status — commit blocked" >&2
    exit $status
fi
